# ======================================================================
# BreachSpillover - Environment Configuration Template (.env.example)
# ======================================================================
# Copy this file to .env and fill in your API key:
# copy .env.example .env
# ======================================================================

# Recommended: Groq Cloud API Key (Meta Llama 3.3 70B - 300 to 500 tokens/sec)
# Free instant key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Google Gemini API Key
# Free instant key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Have I Been Pwned (HIBP v3 Paid API Key)
# Key subscription ($3.50/mo): https://haveibeenpwned.com/API/Key
# If empty, BreachSpillover automatically uses XposedOrNot, Hudson Rock, and the local 1,038-breach catalog for free.
HIBP_API_KEY=
